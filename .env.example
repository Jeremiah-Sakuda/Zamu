# --- storage ---------------------------------------------------------------------
# SQLite by default: one file, no server, no credentials.
ZAMU_DB=.zamu/zamu.sqlite

# --- links -----------------------------------------------------------------------
# Public base URL, used to build the one-tap accept and decline links in emails.
ZAMU_BASE_URL=http://localhost:8000

# Origins allowed to call the API (the console).
ZAMU_CORS_ORIGINS=http://localhost:3000

# --- model ---------------------------------------------------------------------
# Leave unset to use the default tier. Zamu falls back to its deterministic planner
# when no Bedrock credentials are present, so nothing here is required to run.
# ZAMU_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1

# Force the deterministic planner even when credentials exist. Useful for a
# reproducible demo.
# ZAMU_FORCE_PLANNER=1

# --- email (optional) ------------------------------------------------------------
# Without these Zamu captures messages in an outbox you can read in the console,
# which is a real delivery path, not a stub.
# ZAMU_SES_SENDER=zamu@your-verified-domain.org
# ZAMU_SES_REGION=us-east-1
